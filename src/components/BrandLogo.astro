---
/**
 * The Rainy Peaks lockup: hand-drawn rain over peaks, with the
 * "rainyPEAKS" wordmark. The mark inherits currentColor, so it takes the
 * accent in the header and stays legible on light and dark alike.
 *
 * variant "row"   : mark beside the wordmark (header, tight spaces)
 * variant "stack" : mark above the wordmark with the WEB DESIGN rule (footer)
 */
interface Props {
  variant?: 'row' | 'stack';
  tagline?: boolean;
  class?: string;
}

const { variant = 'row', tagline = false, class: className = '' } = Astro.props;
---

<span class:list={['brand', `brand--${variant}`, className]}>
  <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <g
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2.2"
    >
      <g class="brand-rain">
        <path d="M26.4 7.4 23.5 14.5" />
        <path d="M36.3 5 34.6 12.7" />
        <path d="M48 7.4 45.1 14.5" />
        <path d="M19.9 17.5 17.6 24.6" />
        <path d="M31.6 16.9 29.3 23.4" />
        <path d="M42.8 17.5 40.4 24.3" />
      </g>
      <path d="M10.8 56.6C13.6 51 19.4 42.4 21.8 39.6c.6-.6 1.4-.2 2 1c1.2 2.6 2.8 6 4.4 9.2" />
      <path d="M24.5 56.5C27 52 34 38 39.2 28.8c.8-1.3 2.2-1 2.6.5c.8 2.7 2.6 5.1 4.4 6.9c1.2 1.4 1.8 4.4 2.2 8.2c1-3 2.6-5.8 4-5.4c1.4.6 2.8 9 4.2 17.4" />
      <path d="M9.6 56.8c10.4-1.2 24.4.4 34.4-.2c5-.3 9 .3 13.4-.1" />
    </g>
  </svg>

  <span class="brand-words">
    <span class="brand-name"><span class="brand-name-a">rainy</span><span class="brand-name-b">PEAKS</span></span>
    {tagline && <span class="brand-tagline">Web Design</span>}
  </span>
</span>

<style>
  .brand {
    display: inline-flex;
    gap: 0.5rem;
    color: var(--ink);
  }

  .brand--row {
    align-items: center;
  }

  .brand--stack {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .brand-mark {
    flex-shrink: 0;
    width: 1.9em;
    height: 1.9em;
    /* The drawn logo is a single ink colour, navy on light and white on dark. */
    color: var(--ink-soft);
    overflow: visible;
  }

  .brand--stack .brand-mark {
    width: 3.2em;
    height: 3.2em;
  }

  /* The rain reads as a lighter wash than the peaks, as in the logo. */
  .brand-rain {
    opacity: 0.7;
  }

  .brand-words {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-name {
    font-family: var(--font-display);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand-name-a {
    font-style: italic;
    font-weight: 400;
  }

  .brand-name-b {
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .brand-tagline {
    margin-top: 0.4em;
    font-family: var(--font-body);
    font-size: 0.42em;
    font-weight: 500;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
