---
interface Props {
  heading?: string;
}

const { heading = 'What’s inside your free Website Review' } = Astro.props;

const contents = [
  {
    title: 'What’s costing you enquiries',
    text: 'The three to five things on your current site that most get in the way of someone picking up the phone, ranked by how much difference fixing them would make.',
  },
  {
    title: 'Speed and mobile scores',
    text: 'How fast your site actually loads on a phone on 4G, what’s slowing it down, and what a realistic target looks like.',
  },
  {
    title: 'How you compare locally',
    text: 'A look at two competitors ranking above you, what their sites do differently, and where the gap is genuinely worth closing.',
  },
  {
    title: 'Quick wins for this month',
    text: 'Two or three things you could fix in an afternoon without a rebuild, with plain-English instructions.',
  },
  {
    title: 'Rebuild or repair?',
    text: 'An honest answer on whether your site needs a tidy-up or a fresh start, with indicative costs for each route.',
  },
  {
    title: 'Accessibility & search basics',
    text: 'The accessibility and on-page issues most likely to be holding you back, written for owners rather than developers.',
  },
];
---

<section class="section section--alt" id="report">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">Your free review</p>
      <h2>{heading}</h2>
      <p>
        Not a sales brochure, a genuinely useful document you can act on yourself, written
        specifically for your website after our conversation.
      </p>
    </div>
    <div class="grid grid--3">
      {
        contents.map((item) => (
          <div class="card reveal">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
