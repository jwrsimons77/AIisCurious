---
/**
 * Dedicated landing page for paid traffic (Meta ads).
 * Deliberately minimal: no navigation, one message, one action.
 * noindex + excluded from the sitemap; ads link here with UTM tags.
 */
import Base from '../layouts/Base.astro';
import ReviewForm from '../components/ReviewForm.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { site } from '../data/site';

const trustPoints = [
  'Manchester based',
  'Independent, no tool commissions',
  'Plain English, no jargon',
  'No obligation, ever',
];

const reportPoints = [
  'Your top 3–5 fixes, ranked by effort and payoff',
  'Speed and mobile scores, explained in plain English',
  'How you compare with two competitors ranking above you',
  'An honest answer on rebuild versus repair, with indicative costs',
  'A simple 90-day plan, yours to keep whatever you decide',
];
---

<Base
  title="Free Website Review for Your Business | Rainy Peaks"
  description="One free 15-minute call. One personalised report showing exactly what is stopping your website winning work. Manchester based, plain English, no obligation."
  noindex={true}
  minimal={true}
>
  <section class="lp">
    <div class="container container--narrow">
      <div class="lp-logo" aria-hidden="true"><BrandLogo /></div>

      <h1>Find out exactly why your website isn't winning you work</h1>
      <p class="lp-lede">
        Three quick boxes, then a short, personalised report showing what's holding your site
        back, what each fix involves, and what it would cost. Written for your business, in plain
        English.
      </p>

      <ul class="lp-trust" role="list">
        {trustPoints.map((point) => <li>{point}</li>)}
      </ul>

      <div class="lp-form">
        <ReviewForm heading="Get your free review" />
      </div>

      <div class="lp-detail">
        <h2>What's in the review</h2>
        <ul class="checklist">
          {reportPoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>

      <div class="lp-person">
        <h2>Who you'll be talking to</h2>
        <p>
          I'm James, an independent web designer based in Manchester with a background in product
          management, enterprise software and digital design. No agency, no call centre, no
          sales team. The person on the call is the person who writes your review.
        </p>
        <p class="lp-honest">
          And an honest promise: if your site only needs a few small fixes rather than a rebuild,
          the review will say exactly that.
        </p>
      </div>

      <footer class="lp-footer">
        <p>
          © {new Date().getFullYear()} {site.name} · Manchester ·
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </footer>
    </div>
  </section>
</Base>

<style>
  .lp {
    padding-block: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .lp-logo {
    font-size: 1.25rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  h1 {
    font-size: var(--text-3xl);
    max-width: 24ch;
  }

  .lp-lede {
    margin-top: 1.25rem;
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 52ch;
  }

  .lp-trust {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lp-trust li {
    padding: 0.35rem 0.9rem;
    background: var(--accent-soft);
    color: var(--accent-ink);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .lp-form {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .lp-form h2,
  .lp-detail h2,
  .lp-person h2 {
    font-size: var(--text-xl);
    margin-bottom: 1rem;
  }

  .lp-detail,
  .lp-person {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .lp-person p {
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .lp-person p + p {
    margin-top: 0.75rem;
  }

  .lp-honest {
    font-style: italic;
    color: var(--muted) !important;
  }

  .lp-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .lp-footer a {
    color: var(--muted);
  }
</style>
